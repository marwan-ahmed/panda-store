{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "marwan-sat/findings.schema.json",
  "title": "Marwan SAT — findings/<lens>.json (audit phase FINDINGS; also the 'missed' list of a challenge file)",
  "description": "One file per lens: security.json (security auditor, SEC-n), logic-money.json (adversarial reviewer, REV-n), gaps.json (architect, GAP-n). Validated by core/bin/lib/audit.mjs (validateFindingsFile, validateFinding), which also checks that confirmed evidence exists inside the task folder, fix_assumes and entry_points refer to INVENTORY ids, and every MISSING/UNKNOWN entry point is examined.",
  "type": "object",
  "required": ["task_id", "lens", "examined", "not_examined", "findings"],
  "properties": {
    "task_id": { "type": "string" },
    "lens": { "enum": ["security", "logic_money", "gaps"] },
    "profile": { "enum": ["web", "mobile"], "description": "security lens only" },
    "examined": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "not_examined": { "type": "array", "items": { "type": "object", "required": ["what", "reason"], "properties": { "what": { "type": "string" }, "reason": { "type": "string" } } } },
    "coverage": {
      "description": "security lens only: one entry per axis of the profile",
      "type": "array",
      "items": { "type": "object", "required": ["axis", "status"], "properties": { "axis": { "type": "string" }, "status": { "enum": ["TESTED_DYNAMIC", "REVIEWED_STATIC", "NOT_TESTED", "NOT_APPLICABLE"] }, "reason": { "type": "string" } } }
    },
    "entry_points_examined": {
      "type": "array",
      "items": { "type": "object", "required": ["id", "auth_check", "note"], "properties": { "id": { "type": "string" }, "auth_check": { "type": "string" }, "note": { "type": "string" } } }
    },
    "scanner_triage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "classification", "reason"],
        "properties": {
          "step": { "enum": ["secrets", "sast", "dependencies"] },
          "tool": { "type": "string" },
          "classification": { "enum": ["finding", "false_positive", "not_reachable", "tool_error"] },
          "finding": { "type": "string" },
          "location": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["id", "title", "type", "area", "severity", "proof", "source", "location", "files", "problem", "expected_behavior"],
      "properties": {
        "id": { "type": "string", "pattern": "^(SEC|REV|GAP|MR|MA)-\\d+$" },
        "title": { "type": "string" },
        "type": { "enum": ["vulnerability", "bug", "missing_control", "feature_gap", "dependency", "tech_debt"] },
        "area": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "groups findings into backlog items" },
        "severity": { "enum": ["critical", "high", "medium", "low"] },
        "proof": { "enum": ["confirmed", "suspected"] },
        "source": { "enum": ["static_review", "dynamic", "reproduction", "scanner", "external_advisory"] },
        "attacker": { "enum": ["unauthenticated", "authenticated", "privileged", "internal", "none"] },
        "reachability": { "enum": ["reachable", "unreachable", "unknown"] },
        "reachability_note": { "type": "string" },
        "location": { "type": "string", "pattern": "^[^\\s#]+#\\S+$", "description": "file#symbol, never a line number; file#(missing) for something absent" },
        "files": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "entry_points": { "type": "array", "items": { "type": "string", "pattern": "^EP-\\d+$" } },
        "compensating_controls": { "type": "array", "items": { "type": "string" } },
        "problem": { "type": "string" },
        "expected_behavior": { "type": "string" },
        "plain": { "type": "string", "description": "One sentence for the owner, without jargon: what could happen, to whom (required when owner.audience is simple)" },
        "evidence": { "type": "string", "description": "required when confirmed: a file inside the task folder (proofs/ or evidence/)" },
        "to_confirm": { "type": "string", "description": "required when suspected and critical/high" },
        "decision_needed": { "type": ["string", "null"] },
        "fix_hint": { "type": ["string", "null"], "description": "non-binding" },
        "fix_assumes": { "type": "array", "items": { "type": "string", "pattern": "^ENV-\\d+$" }, "description": "required with fix_hint" },
        "external_claims": { "type": "array", "items": { "type": "object", "required": ["claim", "source", "checked_at"], "properties": { "claim": { "type": "string" }, "source": { "type": "string" }, "checked_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" } } } },
        "package": { "type": "string" },
        "usage": { "type": "array", "items": { "type": "string" } },
        "blocked_by": { "type": "array", "items": { "type": "string" } },
        "isolate": { "type": "boolean" }
      }
    }
  }
}
